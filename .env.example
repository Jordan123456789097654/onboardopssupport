# Discord bot credentials (from Discord Developer Portal).
# IMPORTANT: Enable "Message Content Intent" and "Server Members Intent" under Bot -> Privileged Gateway Intents.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Public domain for transcripts and online staff dashboard (e.g. support.onboardops.org)
BASE_URL=https://support.onboardops.org

# Online Dashboard role permissions (comma-separated Discord role IDs that are allowed to access the dashboard)
DASHBOARD_ROLE_IDS=123456789012345678,987654321098765432
DASHBOARD_GUILD_ID=

# Secret for signing session cookies
SESSION_SECRET=onboardops-random-secure-cookie-secret-12345

# Optional: if set, commands also register immediately to this dev guild in addition to global commands.
# Leave empty in production for pure global multi-server commands.
DEV_GUILD_ID=

# Optional: PostgreSQL connection string (e.g. ${{Postgres.DATABASE_URL}} on Railway).
# If omitted, the bot automatically saves state to ./data/store.json.
DATABASE_URL=

# Port for web panel, health check, and transcripts (Railway sets PORT automatically).
PORT=3000
